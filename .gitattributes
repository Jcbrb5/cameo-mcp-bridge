# Normalize line endings so Windows checkouts don't show every file as modified.
* text=auto eol=lf

# Windows scripts need CRLF in the working tree.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix scripts must stay LF.
*.sh text eol=lf
gradlew text eol=lf

*.jar binary
*.png binary
*.jpg binary
*.pptx binary
*.docx binary
